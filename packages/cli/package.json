{
  "name": "altweb",
  "version": "1.1.0",
  "description": "CLI for ALTWEB signed context capsules: compile markdown into self-contained, verifiable, optionally encrypted artifacts \u2014 and verify them offline. Verify before you inject.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Daniel C. \u0218OIMU",
  "homepage": "https://altweb.software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsoimu/altweb.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/danielsoimu/altweb/issues"
  },
  "keywords": [
    "ai-agents",
    "context",
    "capsule",
    "signing",
    "ecdsa",
    "provenance",
    "prompt-injection",
    "markdown",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "altweb": "dist/altweb.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/altweb.mjs --external:jsdom --banner:js='#!/usr/bin/env node'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jsdom": "^28.1.0"
  },
  "devDependencies": {
    "@altweb/core": "*",
    "esbuild": "^0.25.0"
  }
}
