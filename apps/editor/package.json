  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.18",
